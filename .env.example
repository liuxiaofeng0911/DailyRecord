# ===== 端口 =====
WEB_PORT=8080
API_PORT=8000

# ===== 构建版本 =====
# scripts/build.sh 会自动写入本次构建版本；手工 compose 启动可保持 latest
APP_VERSION=latest

# ===== 时区 =====
TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

# ===== PostgreSQL =====
POSTGRES_DB=diary
POSTGRES_USER=diary
POSTGRES_PASSWORD=change-me
# 本地调试直连宿主映射出来的库（docker 的 postgres 映射到 127.0.0.1:5432）
# 容器内由 docker-compose 覆盖为 postgres:5432
DATABASE_URL=postgresql+psycopg://diary:change-me@127.0.0.1:5432/diary

# ===== Redis =====
# 本地调试连宿主映射；容器内由 docker-compose 覆盖为 redis:6379
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
# 生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-48-byte-secret
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_THRESHOLD_MINUTES=60

# ===== RSA =====
# 二选一：Base64 单行文本，或挂载文件路径
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=
# RSA_PRIVATE_KEY_PATH=/run/secrets/rsa_private.pem
# RSA_PUBLIC_KEY_PATH=/run/secrets/rsa_public.pem

# ===== 密码哈希 =====
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2

# ===== Immich 照片库（可选，不部署时照片保存在本机）=====
# 本地调试走宿主映射端口；容器内由 docker-compose 覆盖为 immich-server:2283
IMMICH_URL=http://localhost:2283
IMMICH_PORT=2283
IMMICH_UPSTREAM=immich-server:2283
IMMICH_DB_PASSWORD=change-me-immich-db
IMMICH_ADMIN_EMAIL=admin@dailyrecord.local
IMMICH_ADMIN_PASSWORD=change-me-immich-admin
# 运行 python scripts/init_immich.py 自动写入
IMMICH_ADMIN_API_KEY=
IMMICH_AUTO_PROVISION=true
IMMICH_PROVISION_QUOTA=20
# 32 字节 Base64，用于加密每账号 Immich API Key
CREDENTIAL_ENCRYPTION_KEY=
# 兼容旧配置（不再用于日常上传）
IMMICH_API_KEY=
IMMICH_ALBUM_ID=
IMMICH_WRITE_DESCRIPTION=true

# ===== AI（P2，默认关闭） =====
AI_ENABLED=false
# 本地调试连宿主 Ollama；容器内由 docker-compose 覆盖为 host.docker.internal:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=qwen3-vl:2b
OLLAMA_TEXT_MODEL=qwen2.5:7b

# ===== 上传与日志 =====
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
