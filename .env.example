# ===== 端口 =====
WEB_PORT=8080
API_PORT=8000

# ===== 构建版本 =====
# scripts/build.sh 会自动写入本次构建版本；手工 compose 启动可保持 latest
APP_VERSION=latest

# ===== 时区 =====
TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

# ===== PostgreSQL =====
POSTGRES_DB=diary
POSTGRES_USER=diary
POSTGRES_PASSWORD=change-me

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== JWT =====
# 生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-48-byte-secret
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_THRESHOLD_MINUTES=60

# ===== RSA =====
# 二选一：Base64 单行文本，或挂载文件路径
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=
# RSA_PRIVATE_KEY_PATH=/run/secrets/rsa_private.pem
# RSA_PUBLIC_KEY_PATH=/run/secrets/rsa_public.pem

# ===== 密码哈希 =====
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2

# ===== Immich =====
# 宿主机上的 Immich；容器内通过 host.docker.internal 访问
IMMICH_URL=http://host.docker.internal:2283
IMMICH_UPSTREAM=host.docker.internal:2283
IMMICH_API_KEY=
IMMICH_ALBUM_ID=
IMMICH_WRITE_DESCRIPTION=true

# ===== AI（P2，默认关闭） =====
AI_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_VLM_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5:7b

# ===== 上传与日志 =====
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
